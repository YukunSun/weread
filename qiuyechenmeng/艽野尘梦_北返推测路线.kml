          </LineString>
        </MultiGeometry>
      </Placemark>
      <Placemark id="north_return_segment_riyue_to_huangyuan">
        <name>日月山→丹噶尔〔主候选假说〕</name>
        <visibility>1</visibility>
        <description>&lt;h3&gt;日月山→丹噶尔〔主候选假说〕&lt;/h3&gt;&lt;p&gt;整体低把握的可修订假说&lt;/p&gt;&lt;p&gt;根据章节先后和地区关系连接；复用原图古城地区点，旅店未定位。223日为江达到此大段总时长。&lt;/p&gt;&lt;p&gt;时日：过日月山下山宿后，原文随后行2日到丹噶尔。&lt;/p&gt;&lt;p&gt;细虚线为地区间推测连接，省略实际绕折；未恢复古道，未计历史实走公里数。&lt;/p&gt;&lt;p&gt;&lt;a href="https://read.99csw.com/book/554/17577.html"&gt;第11章及校注54—59&lt;/a&gt;&lt;br/&gt;&lt;a href="https://www.xuges.com/xdwx/qycm/31.htm"&gt;第11章后段&lt;/a&gt;&lt;/p&gt;</description>
        <LookAt>
          <longitude>96.8</longitude>
          <latitude>33.5</latitude>
          <altitude>0</altitude>
          <heading>0</heading>
          <tilt>0</tilt>
          <range>1400000</range>
          <altitudeMode>clampToGround</altitudeMode>
        </LookAt>
        <Style>
