          </Data>
          <Data name="basis">
            <value>第9章记掌形小山、清泉及矮树，明言不是冈天削。本点为工作事件区，不认现代山峰或泉眼。</value>
          </Data>
          <Data name="source_keys">
            <value>ch9</value>
          </Data>
          <Data name="coordinate_role">
            <value>阅读工作锚；非历史确址</value>
