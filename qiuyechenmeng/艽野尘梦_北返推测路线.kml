        <Point>
          <altitudeMode>clampToGround</altitudeMode>
          <coordinates>93.200000,34.800000,0</coordinates>
        </Point>
      </Placemark>
      <Placemark id="north_return_lama">
        <name>蒙古喇嘛事件〔大方向区·极低〕</name>
        <visibility>1</visibility>
