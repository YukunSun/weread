              <north>31.22333</north>
              <south>31.023329999999998</south>
              <east>96.79306000000001</east>
              <west>96.55306</west>
            </LatLonAltBox>
            <Lod>
              <minLodPixels>32</minLodPixels>
              <maxLodPixels>-1</maxLodPixels>
            </Lod>
          </Region>
          <ExtendedData>
            <Data name="old_names">
              <value>恩达／恩达寨</value>
            </Data>
            <Data name="modern_reference">
              <value>类乌齐县桑多镇恩达村</value>
            </Data>
            <Data name="chapter">
              <value>第2—3章</value>
            </Data>
            <Data name="certainty">
              <value>村域参照</value>
            </Data>
            <Data name="timing">
              <value>第2章探险末日午前十时到恩达，午后一时启返，当晚十二时回昌都；非连续行走的实测用时。第3章另一次恩达北行至拉里为月余，20余日子段包含其中，不与第2章混并。</value>
            </Data>
            <Data name="reference_distance">
              <value>距昌都老城、强巴林寺一带代表点直线约48 km</value>
            </Data>
            <Data name="note">
              <value>坐标保留KNAB的Nganda／恩达村地区点，结合官方旧驿站与瓦合山实地资料；不是昌都近郊另一个恩达／小恩达。第2章陈渠珍确曾被押到恩达，交涉获释后返昌都，不能画成仅到纳贡山或纳贡塘折返。登珠营地、汛署及受讯建筑确址均未定；14层补原书图和校注的地名顺序。</value>
            </Data>
          </ExtendedData>
