    <Folder id="folder_context">
      <name>06 现代地理参照｜默认隐藏</name>
      <visibility>0</visibility>
      <open>0</open>
      <Placemark id="place_gongbo">
        <name>参照 工布江达现代县城</name>
        <visibility>0</visibility>
        <Snippet maxLines="1">地理对照 · 背景参照</Snippet>
        <description>&lt;h3&gt;参照 工布江达现代县城&lt;/h3&gt;&lt;p&gt;&lt;b&gt;今名／定位对象：&lt;/b&gt;工布江达县城&lt;br/&gt;&lt;b&gt;对应章节：&lt;/b&gt;地理对照&lt;br/&gt;&lt;b&gt;定位性质：&lt;/b&gt;背景参照&lt;br/&gt;&lt;b&gt;经纬度：&lt;/b&gt;93.2462°E, 29.8868°N&lt;/p&gt;&lt;p&gt;供辨认今地名。与西北方向的太昭／江达村分开；本图不把现代县城当书中“江达”。&lt;/p&gt;&lt;p&gt;坐标的小数位仅为存储格式，不代表历史位置已精确到米。除特别说明外，使用WGS84兼容地名／地标坐标；定位性质比显示位数更重要。&lt;/p&gt;&lt;p&gt;&lt;a href="https://github.com/chaimol/chaimol.github.com/blob/master/book/%E8%89%BD%E9%87%8E%E5%B0%98%E6%A2%A6.txt"&gt;地名与行程：原文、校注&lt;/a&gt;&lt;br/&gt;&lt;a href="https://zh.wikipedia.org/wiki/工布江达县"&gt;坐标参照&lt;/a&gt;&lt;/p&gt;</description>
        <LookAt>
          <longitude>93.2462</longitude>
          <latitude>29.8868</latitude>
          <altitude>0</altitude>
          <heading>0</heading>
          <tilt>0</tilt>
          <range>65000</range>
          <altitudeMode>clampToGround</altitudeMode>
        </LookAt>
        <styleUrl>#context</styleUrl>
        <ExtendedData>
          <Data name="book_name">
            <value>参照 工布江达现代县城</value>
          </Data>
          <Data name="modern_name">
            <value>工布江达县城</value>
          </Data>
          <Data name="chapter">
            <value>地理对照</value>
